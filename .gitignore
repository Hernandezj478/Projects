# =======================
# Core C++ Ignore Rules
# =======================

# Object & Build Artifacts
*.o
*.obj
*.lo
*.slo
*.suo
*.sdf
*.opensdf
*.pdb
*.pch
*.ipch
*.idb
*.res
*.ilk

# Compiled Binaries
*.exe
*.dll
*.so
*.dylib
*.app
*.out

# Static & Shared Libraries
*.lib
*.a
*.la
*.lai

# Precompiled Headers
*.gch

# =======================
# Visual Studio
# =======================
.vs/
*.VC.db
*.VC.opendb
*.vsconfig

# Build Directories
x64/
x86/
Release/
Debug/
build/
bin/
Binaries/

# =======================
# IDE / OS / Misc
# =======================
*.log
*.db
*.db-shm
*.db-wal
*.opendb
*.vsidx
.DS_Store
Thumbs.db

# =====================================
# NetBeans C/C++ auto-generated files
# =====================================

# Entire NetBeans project settings
nbproject/

# Remove all private metadata
nbproject/private/

# NetBeans indexer files
c_standard_headers_indexer.c
cpp_standard_headers_indexer.cpp

# NetBeans config XML files
nbproject/Makefile-*.mk
nbproject/Configurations.xml
nbproject/Project.xml
nbproject/private/configurations.xml
nbproject/private/private.xml

# NetBeans build scripts
package-*.bash

# Generated makefiles
Makefile
Makefile-*.mk

# Build output folders
build/
dist/

# NetBeans dependency files
*.dep